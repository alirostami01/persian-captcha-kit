{
  "name": "persian-captcha-kit",
  "version": "1.0.0",
  "description": "Secure, lightweight Persian SVG Captcha kit for Node.js, Next.js, and React",
  "author": "Ali Rostami",
  "license": "MIT",
  "homepage": "https://github.com/alirostami01/persian-captcha-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirostami01/persian-captcha-kit.git"
  },
  "bugs": {
    "url": "https://github.com/alirostami01/persian-captcha-kit/issues"
  },
  "keywords": [
    "captcha",
    "persian-captcha",
    "farsi-captcha",
    "persian",
    "farsi",
    "svg-captcha",
    "security",
    "nextjs",
    "react",
    "nodejs",
    "hmac",
    "iran"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && node --test tests/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
